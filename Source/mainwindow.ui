   <string notr="true">QWidget {
	background-color: white;
}


QPushButton {
	background-color: rgb(235, 236, 237);
	font: 12pt bold;
	border-radius: 7px;
	border-style: none; 
	color: rgb( 33, 32, 53 );
}

QLabel {
	background: transparent;
	color: rgb(33,32,53);
}


QTabBar::tab{
	background-color: rgb(235, 236, 237);
    color: rgb(34,33,54);
	font: bold 12pt;
    border: 0px;
    height: 64px;
	width: 133px;
    padding: 0px 8px;
    margin: 0 0 19px 0px;
    border-left: 1px solid rgb(213,215,217);
}

QTabBar::tab:selected {
	background-color: rgb(213,215,217);
	color: rgb(34,33,54);
}


QSlider::groove:horizontal {
	background-color: rgb(33,32,53);
	background-color: rgb(53,53,72);
	background-color: rgb(213,215,217);
    height:  6px;
    rounding: 3px;
    margin: 0px;
}

QSlider::handle:horizontal {
    background-color: white;    
	border-color: rgb(153,53,72);
	border-color: rgb(85, 255, 127);
	border-radius: 7px;
    border: 2px solid;
    height: 12px;
    width: 12px;
    margin: -5px 0px;
}

QTableWidget {
	color: rgb(33,32,53);
	font: 10pt;
	gridline-color: rgb(213,215,217);
}

QProgressBar {
	background-color: #EBECED;
	color: black;
	font: 10pt;
	text-align: right;
	border-style: none;
    border-radius: 5px;
}

QProgressBar::chunk {
	background-color: #00A633;
	border-radius: 5px;
}

